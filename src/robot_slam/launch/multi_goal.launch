<launch>
  <node name="navigation_node" pkg="robot_slam" type="demo.py" output="screen">
      <!-- 
           赛级点位索引全景对照：
           0: 起点 (原点)
           1: 信息点1 (5号) -> 触发视觉识别
           2: 信息点2 (45号) -> 触发视觉识别
           3: 信息点3 (77号) -> 触发视觉识别
           4: 信息点4 (37号) -> 触发视觉识别
           5 ~ 13: 9个九宫格任务点 (31, 32, 33, 40, 41, 42, 49, 50, 51号)
           14: 终点 (最后的9号点)
      -->
      <param name="goalListX"   value="0.10,  0.273,  1.53,  2.84,  1.63,  1.17,  1.17,  1.17,  1.54,  1.57,  1.57,  1.97,  2.00,  1.98,  0.05"/>
      <param name="goalListY"   value="0.10,  1.65,  2.98,  1.65,  0.294,  1.26,  1.68,  2.12,  1.29,  1.66,  2.08,  1.20,  1.66,  2.07,  3.32"/>
      <param name="goalListYaw" value="   0,   180,    90,    0,   -90,   180,   180,   180,   -90,     0,    90,   -90,     0,    90,   -90"/>
  </node>
</launch>
